# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this `.env.example` is committed as the canonical template.
#
# All `PUBLIC_*` vars are exposed to client-side code at build time. They are not secrets —
# anyone visiting the site can see these values in the rendered HTML or network requests.
# Real secrets (API keys, tokens) belong in env vars WITHOUT the PUBLIC_ prefix, OR in
# GitHub Actions secrets.

# Listmonk newsletter integration
# - Get the LIST_UUID from Listmonk Admin → Lists → click your list → "UUID" field
# - The HOST is your Listmonk subdomain (no trailing slash)
PUBLIC_LISTMONK_HOST=https://lists.seanreardon.com
PUBLIC_LISTMONK_LIST_UUID=

# Cloudflare Turnstile — paired with the contact-form Cloudflare Worker (see worker/README.md).
# - Site key (this var) is public; the secret key lives in Worker secrets.
# - Register a Turnstile widget at https://dash.cloudflare.com → Turnstile → Add site
# - For local dev, use Cloudflare's documented test keys (always pass) instead of localhost-registering:
#     site:   1x00000000000000000000AA
#     secret: 1x0000000000000000000000000000000AA
#   Docs: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=
