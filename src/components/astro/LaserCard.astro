---
/* ============================================================================
   LaserCard — reusable card with brass beam + cyan/plasma helix on hover
   ============================================================================
   The site's third laser-card pattern (alongside header purple-laser and
   hero cyan-quote-box). Used on the home page recent-items grid, the
   /projects/ index, and the /lessons-learned/ index — anywhere the site
   surfaces a list of entries with a "title + summary + date" shape.

   At rest: muted brass-orange beam outline on a translucent dark card.
   On hover: brass beam thickens to a 3px channel with electric-yellow
   color and a stronger glow; behind it, a cyan sine wave winds around
   the perimeter passing under the brass at crossings; in front of it,
   a plasma reddish-orange sine wave winds the other way (antiphase) —
   reads as a double helix wrapping the main beam. The wave shape
   undulates over time via requestAnimationFrame (see the inline script
   at the end of this file).

   Component handles ONE card. Pages wrap multiple instances in their
   own list/grid markup with their own preferred layout (single-column,
   responsive grid, etc.). */

interface Props {
  /** Where the card links to */
  href: string;
  /** Small mono label at the top of the card (e.g. "Project", "Writing") */
  kind: string;
  /** Card title — large brass-gold text, becomes electric-yellow on hover */
  title: string;
  /** Body text under the title — usually the entry's short description */
  summary: string;
  /** ISO date string for the <time datetime> attribute */
  dateISO: string;
  /** Human-readable date text (page chooses format — full date, year-only, etc.) */
  dateDisplay: string;
}

const { href, kind, title, summary, dateISO, dateDisplay } = Astro.props;
---
<a href={href} class="laser-card">
  <svg class="weave-svg weave-cyan" aria-hidden="true">
    <path class="weave-path" />
  </svg>
  <svg class="weave-svg weave-plasma" aria-hidden="true">
    <path class="weave-path" />
  </svg>
  <span class="laser-card-kind">{kind}</span>
  <h3>{title}</h3>
  <p>{summary}</p>
  <time datetime={dateISO}>{dateDisplay}</time>
</a>

<style>
  /* Card — brass-laser beam with a cyan + plasma double-helix wave
     pair on hover. Layering (scoped to the card's own stacking context
     via `isolation: isolate`):
       - z-index: -1 → .weave-cyan SVG (cyan sine BEHIND main beam)
       - z-index:  1 → ::before pseudo (main brass beam)
       - z-index:  2 → .weave-plasma SVG (plasma sine IN FRONT of beam)
       - z-index:  3 → in-flow content (kind, h3, p, time)

     The cyan + plasma paths are generated by the inline script at the
     end of this file — sine waves traced around the card perimeter
     with amplitude windowed to zero at corners. Where the cyan crosses
     through the brass strip, brass paints over it (z-index 1 > -1) —
     the "helix passing behind" illusion. Plasma is in front so it's
     visible everywhere along its path — the warm counterpoint thread.

     On hover: brass beam thickens to 3px channel in electric-yellow,
     both waves fade in, wave phase animates via JS — peaks travel
     around the perimeter at ~4s/cycle. */
  .laser-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: rgba(0, 0, 0, 0.3);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    /* height: 100% added 2026-05-18 — fills the grid cell so cards
       in the same row share a common height (determined by the
       tallest card's content). The grid itself already auto-sizes
       rows to their tallest cell + stretches <li>s to fill, but
       this card was sizing to its own content within that <li>.
       Different rows still vary independently by their tallest
       card. Benign at single-column usage (projects/lessons-learned
       indexes): the row IS the card, so height:100% just equals
       the card's natural height — no visible change. */
    height: 100%;
    transition: background var(--transition-fast);
  }

  /* Main brass beam — pseudo-element so z-index can layer the weave
     SVGs above AND below it. The card itself has no border. */
  .laser-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(196, 149, 57, 0.55);
    pointer-events: none;
    z-index: 1;
    box-shadow:
      0 0 6px 0 rgba(196, 149, 57, 0.18),
      inset 0 0 10px 1px rgba(196, 149, 57, 0.08);
    transition:
      border 150ms ease-out,
      box-shadow 150ms ease-out;
  }

  /* `.is-active` mirrors :hover / :focus-visible (Sean direction 2026-05-21).
     Used on touch-primary devices where there's no :hover state — the inline
     script below attaches an IntersectionObserver that toggles .is-active
     as cards scroll through the center band of the viewport. CSS state is
     identical to hover/focus; only the trigger differs. Listing .is-active
     in every hover rule (rather than a separate parallel block) guarantees
     the two states stay visually in sync as the card design evolves. */
  .laser-card:hover,
  .laser-card:focus-visible,
  .laser-card.is-active {
    background: rgba(0, 0, 0, 0.4);
    outline: none;
  }
  /* Hover beam: 3px electric-yellow channel (dark edge / bright center
     / dark edge) with stronger yellow glow. Color #F5E53D — RGB
     (245, 229, 61), R and G nearly equal, low B — reads as electric
     yellow-gold without the orange cast of the rest-state brass. */
  .laser-card:hover::before,
  .laser-card:focus-visible::before,
  .laser-card.is-active::before {
    border: 3px solid #F5E53D;
    box-shadow:
      inset 0 0 0 1px var(--color-brass-oxidized),
      0 0 0 1px var(--color-brass-oxidized),
      0 0 14px 3px rgba(245, 229, 61, 0.55),
      inset 0 0 16px 2px rgba(245, 229, 61, 0.22);
  }

  /* Cyan + plasma sine-wave layers. Both traced around the perimeter
     by the inline script below; antiphase so they intertwine around
     the brass beam like a double helix.

     `overflow: visible` lets wave peaks/troughs extend past the SVG's
     box without clipping. No viewBox — user units equal CSS pixels,
     so path coordinates from the JS generator map directly to CSS
     pixels (uniform amplitude regardless of card size). */
  .weave-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .weave-cyan { z-index: -1; }
  .weave-plasma { z-index: 2; }

  .weave-cyan .weave-path {
    fill: none;
    stroke: var(--color-electric-cyan-glow);
    stroke-width: 2.5;
    filter: drop-shadow(0 0 4px rgba(102, 232, 255, 0.5));
  }
  .weave-plasma .weave-path {
    fill: none;
    stroke: var(--color-plasma);
    stroke-width: 2;
    filter: drop-shadow(0 0 4px rgba(255, 90, 26, 0.6));
  }

  .laser-card:hover .weave-svg,
  .laser-card:focus-visible .weave-svg,
  .laser-card.is-active .weave-svg {
    opacity: 1;
  }

  /* Small kind label at the top of each card (e.g. PROJECT / WRITING).
     Mono caps in muted color — reads as a log-line tag, not a
     decorative chip. position + z-index puts it above the brass beam's
     inner glow halo. */
  .laser-card-kind {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    position: relative;
    z-index: 3;
  }

  /* Title — muted brass at rest. On hover, color stays brass (no hue
     shift); a brass-toned text-shadow glow fades in over 200ms,
     matching the marquee CTA button's "outline keeps its color, glow
     added" vocabulary (standing rule captured 2026-05-14). The card's
     beam still shifts to electric-yellow on hover — that color is part
     of the laser-beam identity, not the title's. Beam brings the
     electric punch; title brings the restrained glow. */
  .laser-card h3 {
    margin: 0;
    color: var(--color-brass);
    font-family: var(--font-subhead);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    position: relative;
    z-index: 3;
    transition: text-shadow 200ms ease-out;
  }
  .laser-card:hover h3,
  .laser-card:focus-visible h3,
  .laser-card.is-active h3 {
    text-shadow:
      0 0 6px rgba(232, 185, 94, 0.8),
      0 0 18px rgba(196, 149, 57, 0.5);
  }

  .laser-card p {
    margin: 0;
    color: var(--color-fg);
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: none;  /* override the global p max-width — card is the constraint */
    position: relative;
    z-index: 3;
  }
  .laser-card time {
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    /* margin-block-start: auto pushes time to the bottom of the flex
       column so all card timestamps align horizontally when cards are
       in a grid row with stretched heights. */
    margin-block-start: auto;
    padding-block-start: var(--space-xs);
    position: relative;
    z-index: 3;
  }
</style>

<script>
  /* ============================================================================
     LaserCard sine-wave path generator + hover phase animation
     ============================================================================
     Astro hoists default `<script>` blocks once per page regardless of
     how many times the component renders, so this runs once and finds
     all .laser-card instances on the page via querySelectorAll.

     Generates two antiphase sine waves traced around each card's
     perimeter (one for cyan, one for plasma), with amplitude windowed
     to zero at corners. On hover, wave phase animates via rAF — peaks
     travel around the perimeter. Only the hovered card animates; rAF
     cancels on mouseleave.

     prefers-reduced-motion: reduce → skip rAF, render static phase=0. */
  (function () {
    const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TOUCH_PRIMARY = window.matchMedia('(pointer: coarse)').matches;

    /* Module-scoped state for the touch-device single-active-card model
       (Sean direction 2026-05-21, iteration 2 of SPR-0028). The earlier
       per-card IntersectionObserver let multiple cards intersect the center
       band simultaneously on tall viewports — feels noisy. This refactor
       picks the single card whose center is CLOSEST to viewport center,
       recomputed on every scroll/resize frame. Exactly one card animates
       at a time; the rest are at rest.

       Shared across all cards on the page:
       - touchCards: every LaserCard on the page (populated in setupCard)
       - activeCard: the currently-animating element (or null)
       - rafScheduled: dedupe flag for scroll throttling */
    interface TouchCardEntry {
      card: Element;
      start: () => void;
      stop: () => void;
    }
    const touchCards: TouchCardEntry[] = [];
    let activeCard: Element | null = null;
    let rafScheduled = false;

    /* recomputeActiveCard — find the card whose center is closest to
       viewport center, switch the .is-active class + rAF animation if it
       changed. Bounded by an activation radius so cards far from the
       center (or off-screen entirely) don't activate. */
    function recomputeActiveCard() {
      const viewportHeight = window.innerHeight;
      const viewportCenter = viewportHeight / 2;
      /* ACTIVATION_RADIUS = 35% of viewport height. A card's CENTER must be
         within this distance of viewport center to be eligible. Outside the
         radius → not a candidate. Matches the spatial feel of the prior
         "center 30% band" intersection model but enforces single-card
         winner rather than allowing co-intersections. */
      const ACTIVATION_RADIUS = viewportHeight * 0.35;

      let bestEntry: TouchCardEntry | null = null;
      let bestDistance = Infinity;
      for (const entry of touchCards) {
        const rect = (entry.card as HTMLElement).getBoundingClientRect();
        const cardCenter = (rect.top + rect.bottom) / 2;
        const distance = Math.abs(cardCenter - viewportCenter);
        if (distance > ACTIVATION_RADIUS) continue;
        if (distance < bestDistance) {
          bestDistance = distance;
          bestEntry = entry;
        }
      }

      const newActive = bestEntry?.card ?? null;
      if (newActive === activeCard) return;

      /* Deactivate previous */
      if (activeCard) {
        activeCard.classList.remove('is-active');
        const prevEntry = touchCards.find((e) => e.card === activeCard);
        prevEntry?.stop();
      }

      /* Activate new */
      activeCard = newActive;
      if (newActive && bestEntry) {
        newActive.classList.add('is-active');
        bestEntry.start();
      }
    }

    function scheduleRecompute() {
      if (rafScheduled) return;
      rafScheduled = true;
      requestAnimationFrame(() => {
        rafScheduled = false;
        recomputeActiveCard();
      });
    }

    /**
     * Generate SVG path data for a sine wave traced around a rectangle's
     * perimeter, with amplitude windowed to zero at corners.
     */
    function generateWavePath(
      width: number,
      height: number,
      amplitude: number,
      wavesPerEdge: number,
      phase: number
    ): string {
      const samplesPerEdge = 60;
      const pts: [number, number][] = [];

      function addEdge(
        startX: number, startY: number,
        dirX: number, dirY: number,
        perpX: number, perpY: number,
        edgeLength: number
      ) {
        for (let i = 0; i <= samplesPerEdge; i++) {
          const t = i / samplesPerEdge;
          const win = Math.sin(t * Math.PI);
          const wave = amplitude * win * Math.sin(t * wavesPerEdge * 2 * Math.PI + phase);
          const x = startX + t * edgeLength * dirX + wave * perpX;
          const y = startY + t * edgeLength * dirY + wave * perpY;
          pts.push([x, y]);
        }
      }

      // Four edges clockwise; outward perpendicular at each edge points
      // away from card center.
      addEdge(0, 0, 1, 0, 0, -1, width);            // top
      addEdge(width, 0, 0, 1, 1, 0, height);        // right
      addEdge(width, height, -1, 0, 0, 1, width);   // bottom
      addEdge(0, height, 0, -1, -1, 0, height);     // left

      let d = `M ${pts[0][0].toFixed(2)} ${pts[0][1].toFixed(2)}`;
      for (let j = 1; j < pts.length; j++) {
        d += ` L ${pts[j][0].toFixed(2)} ${pts[j][1].toFixed(2)}`;
      }
      d += ' Z';
      return d;
    }

    function setupCard(card: Element) {
      const cyanPath = card.querySelector('.weave-cyan .weave-path');
      const plasmaPath = card.querySelector('.weave-plasma .weave-path');
      if (!cyanPath || !plasmaPath) return;

      const AMPLITUDE = 5;
      const WAVES_PER_EDGE = 4;
      const PHASE_SPEED = Math.PI / 2; // 4 seconds per full sine cycle

      let rafId: number | null = null;
      let startTime: number | null = null;

      function renderPath(phase: number) {
        const rect = (card as HTMLElement).getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          cyanPath!.setAttribute('d',
            generateWavePath(rect.width, rect.height, AMPLITUDE, WAVES_PER_EDGE, phase));
          plasmaPath!.setAttribute('d',
            generateWavePath(rect.width, rect.height, AMPLITUDE, WAVES_PER_EDGE, phase + Math.PI));
        }
      }

      function renderFrame(timestamp: number) {
        if (startTime === null) startTime = timestamp;
        const elapsed = (timestamp - startTime) / 1000;
        const phase = elapsed * PHASE_SPEED;
        renderPath(phase);
        rafId = requestAnimationFrame(renderFrame);
      }

      function start() {
        if (REDUCED_MOTION) return;
        if (rafId !== null) return;
        startTime = null;
        rafId = requestAnimationFrame(renderFrame);
      }
      function stop() {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        renderPath(0);
      }

      renderPath(0);

      if (typeof ResizeObserver === 'function') {
        new ResizeObserver(() => {
          if (rafId === null) renderPath(0);
        }).observe(card);
      }

      card.addEventListener('mouseenter', start);
      card.addEventListener('focusin', start);
      card.addEventListener('mouseleave', stop);
      card.addEventListener('focusout', stop);

      /* Touch-primary devices: register the card with the shared touchCards
         array so the module-level recomputeActiveCard() can pick a single
         winner per scroll frame (Sean direction 2026-05-21 iteration 2 of
         SPR-0028 — was per-card IntersectionObserver, replaced for the
         single-active-card requirement).

         Guard: pointer:coarse covers phones + tablets without desktop
         touchscreens (those have pointer:fine from the mouse). Desktop
         hover behavior is untouched — the touchCards array stays empty
         and the shared scroll listener (attached in init()) early-exits
         since recomputeActiveCard finds no entries.

         Quick tap navigation is unchanged: the click handler on <a href>
         fires on touchstart→touchend without movement. Scroll gestures
         (touchstart→touchmove→touchend) don't fire the click. The two
         behaviors operate on independent event channels. */
      if (TOUCH_PRIMARY) {
        touchCards.push({ card, start, stop });
      }
    }

    function init() {
      document.querySelectorAll('.laser-card').forEach(setupCard);

      /* Single shared scroll + resize listeners drive recomputeActiveCard
         on touch-primary devices. rAF throttling caps recompute at one per
         frame (~60fps) regardless of scroll event frequency. Initial
         recompute on init handles the case where a card is already in
         the activation radius on page load (e.g., direct nav to /projects/
         with the first card centered). */
      if (TOUCH_PRIMARY && touchCards.length > 0) {
        window.addEventListener('scroll', scheduleRecompute, { passive: true });
        window.addEventListener('resize', scheduleRecompute, { passive: true });
        recomputeActiveCard();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
