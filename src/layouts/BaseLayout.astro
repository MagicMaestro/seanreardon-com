---
import Header from '~/components/astro/Header.astro';
import Footer from '~/components/astro/Footer.astro';
import ConsentBanner from '~/components/astro/ConsentBanner.astro';
import screenEdgeRope from '~/assets/images/screen-edge-rope.png';
import '~/styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /* Set true on pages that render their own custom page-title markup inside
     the slot (e.g., the 404 page with its mono "404" treatment). When true,
     BaseLayout skips the default full-bleed <h1>{title}</h1> banner. */
  noPageTitleBar?: boolean;
  /* Include this page in the Pagefind site-search index (standard header
     search). Default false — pages opt IN by passing searchable={true}.
     The opted-in set is intentionally narrow per `decisions/ai-features-v1.md`
     decision 9: writing posts + about/static pages only. Listing pages,
     utility pages (search, subscribe, reach-out, 404), and work entries
     stay out so the index reflects substantive content, not navigation.
     The same corpus rule governs the MiniLM AI-search index — kept in
     sync via `src/lib/search/chunker.ts`'s STATIC_PAGES list and the
     status==='published' filter on writing posts.

     Mechanism: when searchable=false, BaseLayout emits `data-pagefind-ignore`
     on <main> and Pagefind skips the page entirely. When searchable=true,
     no attribute is added and the PAGE is responsible for marking its
     content element (typically an <article>) with `data-pagefind-body` —
     that scope-limits indexing to the article body, excluding nav/footer/
     page-title from the index. */
  searchable?: boolean;
  /* Pages that lean on a form widget (currently /reach-out and /subscribe)
     opt OUT of the site-wide wide-measure rule (`--measure-wide: 75%`,
     centered) and revert to the tighter `--measure: 65ch` left-aligned
     setting for their intro paragraphs and supporting copy. Adds a
     `narrow-measure` class on <main>; the wide-measure rule in global.css
     short-circuits via `main:not(.narrow-measure)`. Default false. */
  narrowMeasure?: boolean;
}

const { title, description, noindex, noPageTitleBar, searchable = false, narrowMeasure = false } = Astro.props;
const fullTitle = title === 'Sean Reardon' ? title : `${title} — Sean Reardon`;
/* Either `data-pagefind-ignore` or nothing — spread onto <main> below.
   Object-spread keeps the JSX terse and lets Astro omit the attribute when
   `searchable` is true (no key to render). */
const mainPagefindAttrs = searchable ? {} : { 'data-pagefind-ignore': '' };
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" type="application/rss+xml" title="Sean Reardon — Lessons Learned" href="/rss.xml" />

    {/* Adobe Fonts — Mostra Nuova (display typeface for h1 / large titles).
        Self-hosted via the Adobe Fonts web project; replace this <link> with
        the actual kit URL from your Adobe Fonts dashboard.
        Privacy disclosure for this dependency lives in /privacy/. */}
    <link rel="stylesheet" href="https://use.typekit.net/spj4bec.css" />
    <link rel="preconnect" href="https://use.typekit.net" />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />

    {/* Tracking via Cloudflare Web Analytics — cookieless, no consent required.
        Best in zone-analytics mode (server-side, no client JS) once the domain is proxied
        through CF. Until then, the standalone JS beacon goes here. See the GDPR + CPRA-lite
        standing rule in CLAUDE.md for what other tracking would (re)introduce a banner. */}
  </head>
  <body>
    <Header />
    {/* main-wrapper is full-viewport-width; <main> inside it is bounded at
        --main-max-width and centered. On wide viewports the gutters on each
        side of main are the natural home for edge-anchored decorations
        (vines, marginalia, section ornaments) — they live here as siblings
        of <main> and position themselves relative to main's outer edges.

        The page-title h1 is rendered as the first child of <main> (not as
        a wrapper sibling), so it full-bleeds to MAIN's edges via a negative
        inline margin — not to viewport edges. On viewports wider than
        --main-max-width the title bar has visible gutters; on narrower
        viewports where main fills the wrapper, the title bar reaches the
        viewport edges naturally. */}
    <div class="main-wrapper">
      <main class:list={[{ 'narrow-measure': narrowMeasure }]} {...mainPagefindAttrs}>
        {!noPageTitleBar && <h1>{title}</h1>}
        <slot />
      </main>
    </div>
    <Footer />
    <ConsentBanner />

    {/* Screen-edge rope decoration — vertical strip riding main's RIGHT
        edge. Image's natural width flows in via --rope-width (so the
        element's width and the center-on-main-edge math both use the
        actual pixel size). Fixed positioning so the rope stays in the
        same viewport spot regardless of scroll; z-index sits below the
        header (z-index 100) and footer (50) so both occlude the rope's
        top + bottom portions naturally. */}
    <div
      class="screen-edge-rope"
      style={`--rope-image: url('${screenEdgeRope.src}'); --rope-width: ${screenEdgeRope.width}px;`}
      aria-hidden="true"
    ></div>

    {/* Custom cyan-laser scroll indicator on the left side of viewport.
        Replaces the hidden native page scrollbar. Track is a fixed cyan strip;
        thumb is a glowing light-cyan blur driven by page scroll position via
        the script below. Hides itself when content fits viewport (no scroll). */}
    <div class="scroll-indicator" data-hidden="false" aria-hidden="true">
      <div class="scroll-indicator-thumb"></div>
    </div>

    <script>
      const indicator = document.querySelector('.scroll-indicator') as HTMLElement | null;
      const thumb = document.querySelector('.scroll-indicator-thumb') as HTMLElement | null;
      const rope = document.querySelector('.screen-edge-rope') as HTMLElement | null;

      // Scroll indicator is visible on every page at every viewport size —
      // Sean direction 2026-05-18 (revised from prior behavior that hid the
      // indicator at <896px when content fits the viewport). The indicator
      // is now a permanent aesthetic element of the layout's left-edge
      // anchoring; pages with short content (e.g., About Me) show the track
      // with the thumb parked at the top, so the visual composition stays
      // consistent across pages.

      function checkScrollable(): boolean {
        // Buffer of 2px to avoid edge cases where content barely overflows
        return document.documentElement.scrollHeight > window.innerHeight + 2;
      }

      function updateIndicator() {
        if (!indicator || !thumb) return;

        // Always-visible: indicator stays shown regardless of scrollability
        // or viewport width.
        indicator.setAttribute('data-hidden', 'false');

        const canScroll = checkScrollable();
        if (!canScroll) {
          // Content fits — park the thumb at the top (no scroll progress
          // to display, but the track itself is still visible).
          thumb.style.transform = 'translateY(0)';
          return;
        }

        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const scrollProgress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
        const trackHeight = window.innerHeight;
        const thumbHeight = thumb.offsetHeight;
        const maxThumbTop = Math.max(0, trackHeight - thumbHeight);

        thumb.style.transform = `translateY(${scrollProgress * maxThumbTop}px)`;
      }

      /* Screen-edge rope — the element itself is position: fixed and stays
         pinned to the viewport, but Sean wants the IMAGE to appear anchored
         to main's content (so scrolling down moves the rope's visible image
         upward, like a parallax fixed to the document). Solution: shift the
         background-position-Y by the negated scroll offset on every frame.
         At scrollY=0 the image's first tile starts at viewport top; at
         scrollY=400 the first tile starts 400px above viewport top (with
         repeat-y, subsequent tiles fill what's visible). Net effect: the
         rope's pattern appears to scroll along with the page content. */
      function updateRope() {
        if (!rope) return;
        rope.style.backgroundPositionY = `${-window.scrollY}px`;
      }

      // Throttled via requestAnimationFrame — same rAF tick updates both
      // the scroll indicator and the rope's background-position, so all
      // scroll-driven changes share one frame.
      let ticking = false;
      function onScrollOrResize() {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateIndicator();
            updateRope();
            ticking = false;
          });
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScrollOrResize, { passive: true });
      window.addEventListener('resize', onScrollOrResize);
      // Initial + after resources finish loading (in case content height changes)
      updateIndicator();
      updateRope();
      window.addEventListener('load', () => {
        updateIndicator();
        updateRope();
      });

      /* H2 drawer laser positioning — measure each h2's actual viewport
         position via getBoundingClientRect() and set a CSS custom property
         the ::after rule uses for `left` and `width` (Sean direction
         2026-05-20 iteration 7).

         Why JS: the laser's left edge needs to terminate exactly at the
         scrollbar's right edge across all viewport widths AND when an
         h2 has a left-float adjacent to it (h2 has `display: flow-root`
         which narrows it beside floats — its computed left position then
         differs from a pure wide-measure 12.5%-gutter calculation). A
         pure-CSS calc can only handle the no-float case at predicted
         widths; JS handles all cases by measuring the rendered DOM.

         Distance = h2.left - scrollbar.right (clamped to >=0).
         Property: --h2-laser-distance, set as inline style on each h2.
         The ::after rule in global.css uses this with a calc()-based
         fallback for the no-JS / pre-JS-run case. */
      const drawerH2s = document.querySelectorAll<HTMLElement>(
        'main > h2:not(.full-bleed), main > div > h2:not(.full-bleed), main > article > h2:not(.full-bleed), main > section > h2:not(.full-bleed)'
      );

      function updateDrawerH2Lasers() {
        if (!indicator || drawerH2s.length === 0) return;
        const scrollbarRect = indicator.getBoundingClientRect();
        const scrollbarRight = scrollbarRect.right;
        for (const h2 of drawerH2s) {
          const h2Rect = h2.getBoundingClientRect();
          const distance = Math.max(0, h2Rect.left - scrollbarRight);
          h2.style.setProperty('--h2-laser-distance', `${distance}px`);
        }
      }

      updateDrawerH2Lasers();
      window.addEventListener('resize', updateDrawerH2Lasers);
      window.addEventListener('load', updateDrawerH2Lasers);
    </script>
  </body>
</html>
