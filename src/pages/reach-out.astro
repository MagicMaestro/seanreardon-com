---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ContactForm from '~/components/astro/ContactForm.astro';
---
<BaseLayout
  title="Reach Out"
  description="Get in touch with Sean Reardon — general inquiries, project questions, or formal privacy requests."
>
  <p>
    Reach out via the form below — general inquiries, questions about something I've shipped,
    or formal privacy requests. Replies usually go out within 24-48 hours.
  </p>
  <p>
    For privacy-policy requests specifically, the
    <a href="/privacy/">privacy policy</a> covers what rights apply (GDPR + California) and
    response timing. Use the "Privacy request" topic in the dropdown.
  </p>
  <p>
    Prefer plain email? <a href="mailto:sean@seanreardon.com">sean@seanreardon.com</a> works too.
  </p>

  <ContactForm />
</BaseLayout>
