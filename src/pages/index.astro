---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LaserCard from '~/components/astro/LaserCard.astro';
import MarqueeFeature, { type MarqueeItem } from '~/components/astro/MarqueeFeature.astro';
import brokenLedge from '~/assets/images/broken-ledge.png';
import brokenLedgeLg from '~/assets/images/broken-ledge-lg.png';
import crackedStoneBg from '~/assets/images/cracked-stone-bg.png';
import crackedStoneBgLg from '~/assets/images/cracked-stone-bg-lg.png';
import { getCollection } from 'astro:content';

/* Hero recent-items grid: 1 most-recent featured project + 2 most-recent
   published posts. Layout is stable across phases:
     - Now: 1 project (this site redesign) + 2 posts
     - When the v1 AI feature ships: AI demo slot takes the lead, project
       and posts shift right
   Schema flag `featured: true` scopes which work entries are eligible
   for the hero. Currently 3 featured-and-active entries (this redesign,
   Maple Glen, Security Line Card) — only the most recent of those
   surfaces here; the others appear on /projects/. */
const featuredProjects = (await getCollection('work', ({ data }) =>
  data.active !== false && data.featured === true
))
  .sort((a, b) => b.data.completed.valueOf() - a.data.completed.valueOf());
const leadProject = featuredProjects[0];

const allPosts = (await getCollection('writing', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = allPosts.slice(0, 2);

/* Marquee items — the homepage marquee between hero and Recent grid.
   Visual + behavioral spec: portfolio-redesign-agent/decisions/002-
   homepage-marquee-and-nozzle-affordance.md (Candidate C steam-clearing
   reveal, locked 2026-05-14).

   v1 launch (interim): single item — post 010 "Embracing AI" — until
   semantic search ships. Once search ships, push the search demo to the
   front of the array; post 010 stays in rotation (rotation mechanism is
   built; auto-cycles when items.length > 1).

   When chat ships at v1.1, prepend a chat marquee item ahead of search.
   The combined surface UX (chat + search behind one nozzle) is still
   TBD — see decisions/002 §4. */
const post010 = allPosts.find((p) => p.slug === 'obsolescence-was-the-wrong-fear');
const marqueeItems: MarqueeItem[] = [];
if (post010) {
  marqueeItems.push({
    title: post010.data.title,
    framing: post010.data.summary,
    primaryCta: {
      href: `/lessons-learned/${post010.slug}/`,
      label: 'Read the post →',
    },
  });
}

/* TEMP — verification-only second marquee item to observe the rotation
   animation live (steam-thicken → content-swap → steam-thin, ~1.5s
   total, 10s interval). Remove before any commit that ships to
   staging or prod. The real second item lands when the semantic
   search build pipeline ships at v1 — at which point this stub gets
   replaced with the actual search-demo card data. Includes a
   secondaryCta so both render paths are exercised during the swap. */
marqueeItems.push({
  title: 'Semantic site search',
  framing: 'A self-hosted, server-side embedding search of every post and page. Your queries never leave the site — no third-party data flow.',
  primaryCta: {
    href: '#',
    label: 'Try it →',
  },
  secondaryCta: {
    href: '#',
    label: 'Read how I built it →',
  },
});
---
<BaseLayout
  title="Sean Reardon"
  description="Sean Reardon — building front-end since 1998, full-stack since 2014, integrating AI language models as first-class material in the web stack. Based in Buffalo, NY."
  noPageTitleBar={true}
>
  {/* Hero — opening question (h1) + tagline (h2 stone strip).
      The h1 inherits a custom "energy quote box" treatment (see CSS
      below); the h2 inherits a verdigris/dark-stone "step" treatment.
      `text-wrap: balance` lets the question split into multi-line
      shapes that feel deliberate at any width. */}
  <h1 class="hero-question">
    What becomes possible when an AI language model is integrated as first-class material into the stack?
  </h1>
  <h2
    class="hero-tagline full-bleed"
    style={`--hero-tagline-bg: url('${crackedStoneBg.src}'); --hero-tagline-bg-lg: url('${crackedStoneBgLg.src}');`}
  >
    <span>
      <span class="plaque-standoff" aria-hidden="true"></span>
      <span class="plaque-standoff" aria-hidden="true"></span>
      <span class="plaque-standoff" aria-hidden="true"></span>
      <span class="plaque-standoff" aria-hidden="true"></span>
      Building front-end since 1998 and full-stack since 2014 — and lately, that's the question driving my designs.
    </span>
  </h2>

  {/* Marquee — single featured AI-features item, full-bleed steam-clearing
      band. v1 launches with post 010 as the interim item; rotation
      mechanism is built so additional items (semantic search demo, chat
      demo) drop in without refactor. See decisions/002 §2. */}
  {marqueeItems.length > 0 && (
    <MarqueeFeature items={marqueeItems} />
  )}

  {/* Marquee ledge — recessed band beneath the marquee. Two textures
      are passed in as CSS variables; CSS picks which one to render
      based on viewport width:
        - --ledge-image (broken-ledge.png) → used at <960px
        - --ledge-image-lg (broken-ledge-lg.png) → used at ≥960px
      Strong inset shadows around the edges preserve the recessed feel.
      Full-bleeds to main's edges (matches the marquee's
      negative-margin pattern). */}
  <div
    class="marquee-ledge"
    style={`--ledge-image: url('${brokenLedge.src}'); --ledge-image-lg: url('${brokenLedgeLg.src}');`}
    aria-hidden="true"
  ></div>

  {/* Recent — laser-border cards via the shared LaserCard component.
      See src/components/astro/LaserCard.astro for the card markup +
      styles + sine-wave hover animation. Grid scales: 1 col at <740,
      2 cols at ≥740, 3 cols at ≥1040. */}
  <section class="recent" aria-labelledby="recent-heading">
    <h2 id="recent-heading" class="full-bleed">Recent</h2>
    <ul class="recent-list">
      {leadProject && (
        <li>
          <LaserCard
            href={`/projects/${leadProject.slug}/`}
            kind="Project"
            title={leadProject.data.title}
            summary={leadProject.data.sh_desc}
            dateISO={leadProject.data.completed.toISOString()}
            dateDisplay={leadProject.data.completed.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
          />
        </li>
      )}
      {posts.map((post) => (
        <li>
          <LaserCard
            href={`/lessons-learned/${post.slug}/`}
            kind="Writing"
            title={post.data.title}
            summary={post.data.summary}
            dateISO={post.data.date.toISOString()}
            dateDisplay={post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* ============================================================================
     Hero — purple energy quote box + stone tagline strip
     ============================================================================
     The home page opts out of the stone full-bleed page-title treatment
     (the global `main > h1:first-of-type` rule excludes .hero-question
     via :not()) — the home page is the only page on the site WITHOUT a
     visible page title bar, since the hero question itself anchors the
     page's voice.

     Treatment: same energy-HUD vocabulary as the mobile nav drawer
     but shifted to near-white CYAN to match the soft cyan halo behind
     the brand-mark logo and gear. */
  .hero-question {
    margin-block: 0 calc(var(--space-md) / 2);
    padding: var(--space-md);
    text-align: center;
    background-color: rgba(0, 0, 0, 0.7);
    background-image: radial-gradient(ellipse at center, rgba(150, 230, 255, 0.42), transparent);
    color: var(--color-fg);
    border: 2px solid rgba(225, 248, 255, 0.95);
    border-radius: var(--radius);
    box-shadow:
      0 0 8px 1px rgba(180, 240, 250, 0.5),
      0 0 20px 3px rgba(102, 232, 255, 0.28),
      inset 0 0 8px 1px rgba(225, 248, 255, 0.4),
      inset 0 0 18px 3px rgba(102, 232, 255, 0.28);
    font-size: 1.75rem;
    line-height: 1.25;
    text-wrap: balance;
  }
  @media (min-width: 740px) {
    .hero-question {
      padding: var(--space-lg) var(--space-md);
      font-size: 2.25rem;
    }
  }
  @media (min-width: 1040px) {
    .hero-question {
      padding: var(--space-lg);
      font-size: 2.75rem;
    }
  }

  /* Tagline — h2 stone strip following the hero question. Heavily
     weathered dark-blotched stone, distinct from h1's lighter
     sandstone via dominant dark wear patches. Full-bleeds to main's
     padding-box edges via negative margin-inline. Carved-into-stone
     text via 3-stop text-shadow (down-right highlight + up-left dark
     + soft halo). */
  .hero-tagline {
    /* Bottom margin: 0 — marquee sits directly beneath, the two
       segments touch (per 2026-05-14 Sean direction).
       Reverted 2026-05-18 (third pass) — the max-width, border-radius
       and outer box-shadow that briefly lived here actually belong on
       the inner .hero-tagline > span (the dark glass plaque). The h2
       returns to its full-bleed stone-slab role.
       Padding bumped 2026-05-18 (later) — var(--space-md) vertical /
       var(--space-xl) horizontal — gives the stone slab more visible
       breathing room around the centered plaque. */
    margin-block: 0;
    margin-inline: calc(-1 * var(--space-md));
    /* Padding tiers (Sean direction 2026-05-20 iteration 9): tight on
       small phones, normal at ≥460px, generous breathing room at ≥620px.
       Matches the StoneTagline component's padding ladder. */
    padding: var(--space-md) var(--space-sm);
    text-align: center;

    /* Background: cracked-stone-bg.png (small) by default, swapping to
       cracked-stone-bg-lg.png at ≥1080px viewports. URLs come in via
       the --hero-tagline-bg and --hero-tagline-bg-lg inline custom
       properties (set on the h2 element); the --hero-tagline-image
       indirection variable below picks whichever is active for the
       current viewport.

       Sizing is responsive (2026-05-18):
         <480px:  100% 100% — stretches both axes so the image fully
                  fills the narrow band (distortion is acceptable at
                  small viewports, where the band is short and content
                  is what matters).
         ≥480px:  100% auto — image scales to full width with height
                  auto-derived from natural aspect (no distortion;
                  may crop or leave subtle space depending on the
                  image's aspect vs the band's aspect).

       Position pinned to `center bottom` so any vertical crop (from
       `100% auto` when the scaled height exceeds the band) is taken
       from the TOP — keeping the lower edge of the texture (where
       the most ledge-detail typically lives) anchored. */
    --hero-tagline-image: var(--hero-tagline-bg);
    --hero-tagline-bg-size: 100% 100%;
    background: var(--hero-tagline-image) center bottom / var(--hero-tagline-bg-size) no-repeat;

    /* White text + light-cyan glow (reverted 2026-05-18, fourth pass —
       the copper-warm version felt off; reverting to the cyan palette
       pulled from .hero-question's energy-box outline, but dialed
       SUBTLER than the prior cyan attempt). Same three-layer structure;
       blur radii and alphas both pulled back ~25–35% so the glow
       reads as a present-but-restrained energy rather than a strong
       halo. Threads visually into the hero-question above. */
    /* `white-space: nowrap` (Sean direction 2026-05-20 iteration 10) —
       tagline text stays on a single line, no soft-wrapping at spaces.
       Same treatment as StoneTagline. */
    white-space: nowrap;
    color: white;
    text-shadow:
      0 0 3px rgba(225, 248, 255, 0.65),
      0 0 8px rgba(102, 232, 255, 0.45),
      0 0 16px rgba(102, 232, 255, 0.25);

    /* Inner shadow added 2026-05-18 — mirrors the .marquee-ledge's
       inset shadow pair (which has warm copper-orange heat glow at the
       TOP and dark inset at the bottom), flipped vertically here so the
       hero-tagline carries the warm glow on its BOTTOM edge. Visually
       continues the marquee's top heat into the tagline's bottom edge,
       reading as one heated zone spanning the marquee+tagline interface.
       Color matches the marquee heat-glow palette: rgba(196, 110, 50).
       border-bottom removed 2026-05-18 (later) — it was rendering as a
       visible black hairline at the tagline/marquee seam; now the warm
       glow + marquee's top heat meet directly with no dividing line. */
    box-shadow:
      inset 0 -6px 18px rgba(196, 110, 50, 0.32),
      inset 0 4px 6px rgba(0, 0, 0, 0.6);

    font-family: var(--font-subhead);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  /* Black glass plaque inside the stone-slab band. The span sits as
     a discrete plate on the stacked-stone slab, providing readable
     backing for the white tagline text.

     Restructured 2026-05-18 (second pass): standoffs were previously
     painted as radial-gradient layers on this span's background;
     they're now real <span class="plaque-standoff"> elements nested
     inside, absolutely positioned at the four corners (see rules
     below). This span no longer carries any standoff styling — just
     the glass base + glare. `position: relative` anchors the
     standoff children. */
  .hero-tagline > span {
    display: block;
    position: relative;
    /* max-width, border-radius, and the heavier box-shadow moved here
       2026-05-18 (third pass) — they belong on the plaque, not on the
       outer h2 stone slab. margin-inline auto so the plaque centers
       horizontally within the wider h2 (especially noticeable on wide
       viewports where the slab extends to main's full-bleed edges
       and the plaque sits centered with stone visible to either side). */
    max-width: 47.5rem;            /* 760px / 16 */
    margin: 0.4rem auto;
    padding: 1.5rem 2.5rem;
    background:
      /* Diagonal highlight glare — narrow bright streak across the
         glass at ~50% along a 115° angle. Subtle but visible. */
      linear-gradient(115deg,
        transparent 30%,
        rgba(255, 255, 255, 0.05) 42%,
        rgba(255, 255, 255, 0.14) 50%,
        rgba(255, 255, 255, 0.05) 58%,
        transparent 70%),
      /* Black glass base — translucent so the stone-slab tint reads
         through faintly */
      rgba(10, 10, 12, 0.88);
    border-radius: 0.5rem;
    box-shadow:
      /* Top edge subtle inner highlight */
      inset 0 1px 1px rgba(255, 255, 255, 0.08),
      /* Bottom edge slight inset shadow */
      inset 0 -1px 2px rgba(0, 0, 0, 0.4),
      /* Outer drop shadow — mounted-with-depth feel against the
         stone slab (heavier than the previous attempt: 2px spread,
         0.9 alpha — per the spec Sean originally aimed at the h2). */
      0 2px 8px 2px rgba(0, 0, 0, 0.9);
  }

  /* Plaque standoffs — four absolutely-positioned span children of
     the .hero-tagline's inner span. Each is a 1.5rem-diameter circle
     painted with a conic-gradient for a cut-stainless-steel feel —
     8 facets alternating between brighter and darker grays, with
     sharp edges between facets (color stops repeated at adjacent
     angles produce hard transitions instead of smooth interpolation).

     Positioned via :first-child / :nth-child / :last-child relative
     to their parent span (which has position: relative). Each sits
     0.5rem from the two edges meeting in its corner. Standoff
     backgrounds are isolated — the inner span's glass background
     does not show through.

     A small box-shadow stack adds depth: a subtle outer drop, a
     bottom inset for the recessed-into-the-plaque illusion, and a
     top inset highlight. */
  .hero-tagline .plaque-standoff {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    /* Conic gradient with SMOOTH transitions between color stops
       (revised 2026-05-18 — the previous paired-angle stops produced
       hard-edged facets that read as a prize-wheel pattern instead
       of cut steel). Each color stop is now placed at a single angle;
       CSS interpolates smoothly between adjacent stops. Same 8 alternating
       bright/dark grays as before — the colors do the cut-steel
       sphere-with-multiple-reflections work; the smooth transition
       just removes the prize-wheel facet edges. The first and last
       stops match (#e8e8e8) so the 360°→0° wrap is seamless. */
    background: conic-gradient(
      #e8e8e8 0deg,
      #989898 45deg,
      #d8d8d8 90deg,
      #a0a0a0 135deg,
      #ececec 180deg,
      #909090 225deg,
      #e0e0e0 270deg,
      #a8a8a8 315deg,
      #e8e8e8 360deg
    );
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.55),
      inset 0 -1px 1px rgba(0, 0, 0, 0.35),
      inset 0 1px 1px rgba(255, 255, 255, 0.25);
  }
  .hero-tagline .plaque-standoff:first-child {
    top: 0.5rem;
    left: 0.5rem;
  }
  .hero-tagline .plaque-standoff:nth-child(2) {
    top: 0.5rem;
    right: 0.5rem;
  }
  .hero-tagline .plaque-standoff:nth-child(3) {
    bottom: 0.5rem;
    left: 0.5rem;
  }
  .hero-tagline .plaque-standoff:last-child {
    bottom: 0.5rem;
    right: 0.5rem;
  }
  /* Padding-inline tier overrides — see the base rule for the reason. */
  @media (min-width: 460px) {
    .hero-tagline {
      padding: var(--space-md) var(--space-md);
    }
  }
  @media (min-width: 620px) {
    .hero-tagline {
      padding: var(--space-md) var(--space-xl);
    }
  }
  /* Background-size swap bumped 580px → 680px (Sean direction
     2026-05-20 iteration 9). */
  @media (min-width: 680px) {
    .hero-tagline {
      --hero-tagline-bg-size: 100% auto;
    }
  }
  @media (min-width: 740px) {
    .hero-tagline {
      font-size: 1.5rem;
    }
  }
  @media (min-width: 1040px) {
    .hero-tagline {
      font-size: 1.75rem;
    }
  }
  @media (min-width: 1080px) {
    /* Swap to the larger cracked-stone-bg-lg.png variant at wide
       viewports — the small variant scaled to 100% width starts to
       feel pixel-stretched here. The indirection variable
       --hero-tagline-image picks up the change without re-declaring
       the full `background` shorthand. Bg-size bumped to `120% auto`
       (Sean direction 2026-05-20 iteration 10) — slight horizontal
       overscale keeps the texture's natural proportions reading
       without visible repeat seams at wide tiers. */
    .hero-tagline {
      --hero-tagline-image: var(--hero-tagline-bg-lg);
      --hero-tagline-bg-size: 120% auto;
    }
  }

  /* Recent-section heading — standalone copy of the hero-tagline stone
     strip styling (per 2026-05-15 direction: keep separate from
     .hero-tagline since the hero tagline is likely to evolve and the
     Recent heading shouldn't drift with it). If both surfaces should
     stay visually identical going forward, the chained-selector version
     was easier to maintain — but Sean explicitly chose duplication so
     the two can diverge independently. */
  .recent h2 {
    margin-block: 0 var(--space-md);
    margin-inline: calc(-1 * var(--space-md));
    padding: var(--space-xs) var(--space-md);
    text-align: center;

    background:
      radial-gradient(ellipse 90% 130% at center,
        rgba(40, 32, 22, 0.45) 0%,
        rgba(40, 32, 22, 0.2) 40%,
        transparent 75%),
      linear-gradient(170deg,
        #ADA593 0%,
        #877E6E 60%,
        #6F6759 100%);

    color: #ccc;
    text-shadow:
      -1px -1px 3px black,
      1px 1px 3px rgba(255, 255, 255, 0.5);

    box-shadow:
      inset 0 5px 9px rgba(255, 245, 220, 0.65),
      inset 0 -8px 14px rgba(15, 8, 2, 0.85);
    border-bottom: 1px solid rgba(20, 12, 5, 0.8);

    font-family: var(--font-subhead);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.4;
    text-wrap: balance;
  }
  @media (min-width: 740px) {
    .recent h2 {
      font-size: 1.5rem;
    }
  }
  @media (min-width: 1040px) {
    .recent h2 {
      font-size: 1.75rem;
    }
  }

  /* ============================================================================
     Marquee ledge — cool-slate recessed band
     ============================================================================
     Sits immediately below the marquee (touches the marquee's bottom
     edge per its margin-block 0 var(--space-lg) pattern). Full-bleeds
     to main's outer edges via the same negative-inline-margin pattern
     as the hero h2 + marquee.

     Visual goal: a cool-slate stone ledge with visible cracks but
     still all-in-place — like a weathered stone band recessed into
     the surrounding surface. The recessed feel comes from:
       1. Strong inset box-shadow (alpha 0.7 black) on all four edges
       2. Vertical gradient darkening toward the bottom (suggests
          the ledge curves slightly back into the wall)
       3. Hairline near-black borders on top and bottom

     Cracks are thin dark linear gradients at varied angles (~95°,
     ~118°, ~140°) crossing the surface. Each is just a few alpha
     stops wide so they read as fault lines, not openings. The stone
     stays visually intact. */
  .marquee-ledge {
    overflow: hidden;            /* clip the image if it overflows the ledge box */
    margin-inline: calc(-1 * var(--space-md));
    height: 3.5rem;
    /* --ledge-bg-size controls the background-size for the texture
       layer. Below 740px: `auto` (natural pixel size, centered) — the
       image fits comfortably within the smaller viewport. At ≥740px
       (media query below): `100% auto` — the image scales to full
       ledge width with height auto-derived so the aspect ratio is
       preserved (no horizontal distortion); some top/bottom clipping
       is expected and acceptable since the 3.5rem ledge is shorter
       than the scaled image height. */
    --ledge-bg-size: auto;
    /* Two-layer background:
         1. broken-ledge.png texture, centered, sized via --ledge-bg-size.
            --ledge-image is set inline on the element so the
            Astro-hashed asset URL flows in.
         2. Base slate gradient as fallback for any uncovered area. */
    background:
      var(--ledge-image) center / var(--ledge-bg-size) no-repeat,
      linear-gradient(180deg, #555c63 0%, #454a51 100%);
    /* Box-shadow shifted 2026-05-15: previously had 5 dark inset shadows
       on all edges (heavy "recessed" feel). Now reduced to two — a
       subtle copper-orange heat glow at the top (cast from the
       marquee's heat radial above), and the original dark shadow at
       the bottom. Reads as the marquee's heat continuing onto the
       ledge's top edge before fading. */
    box-shadow:
      inset 0 6px 18px rgba(196, 110, 50, 0.32),
      inset 0 -4px 6px rgba(0, 0, 0, 0.6);
    /* border-top removed 2026-05-15 — eliminates the visible black
       seam between the marquee's bottom and the ledge's top. The heat
       glow (inset top shadow) now flows continuously from the marquee's
       bottom edge onto the ledge's top edge.
       border-bottom kept — defines the ledge's lower edge against
       whatever follows (currently the Recent grid). */
    border-bottom: 1px solid rgba(0, 0, 0, 0.55);
  }
  @media (min-width: 740px) {
    .marquee-ledge {
      --ledge-bg-size: 100% auto;
    }
  }
  @media (min-width: 960px) {
    /* At wide screens, swap to the wider texture variant
       (broken-ledge-lg.png) and scale it to fill the ledge's width
       at 100% with height auto-derived. The lg image is sized so
       its natural pattern reads well across wider viewports without
       needing to mirror/tile the smaller broken-ledge.png. */
    .marquee-ledge {
      --ledge-bg-size: 100% auto;
      background:
        var(--ledge-image-lg) center / var(--ledge-bg-size) no-repeat,
        linear-gradient(180deg, #555c63 0%, #454a51 100%);
    }
  }

  /* ============================================================================
     Recent section
     ============================================================================
     Section sits well below the hero. Heading uses default h2 styling
     (Cardo) from global.css. Card layout: 1 col / 2 col / 3 col at
     <740 / ≥740 / ≥1040. */
  .recent {
    margin-block-start: var(--space-sm);
  }

  .recent-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }
  @media (min-width: 740px) {
    .recent-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .recent-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* 2-col tier orphan-centering: when the total card count is odd
     (currently 3 — 1 project + 2 posts), the last card lands alone
     in its row at this 2-col viewport. Span it across both columns +
     constrain width to single-column-width + justify-self: center so
     it sits horizontally centered instead of left-stranded.
     Scoped to 740-1039 only — the 1-col tier has no orphan problem
     (everything stacks single-file), and the 3-col tier handles its
     own orphan layouts (and currently has none with 3 cards). The
     :last-child:nth-child(odd) compound selector generalizes the rule
     to any future odd card count (5, 7, …), not just exactly-three. */
