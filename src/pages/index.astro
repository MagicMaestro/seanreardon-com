---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LaserCard from '~/components/astro/LaserCard.astro';
import MarqueeFeature, { type MarqueeItem } from '~/components/astro/MarqueeFeature.astro';
import StoneTagline from '~/components/astro/StoneTagline.astro';
import brokenLedge from '~/assets/images/broken-ledge.png';
import brokenLedgeLg from '~/assets/images/broken-ledge-lg.png';
import { getCollection } from 'astro:content';

/* Hero recent-items grid: 1 most-recent featured project + 2 most-recent
   published posts. Layout is stable across phases:
     - Now: 1 project (this site redesign) + 2 posts
     - When the v1 AI feature ships: AI demo slot takes the lead, project
       and posts shift right
   Schema flag `featured: true` scopes which work entries are eligible
   for the hero. Currently 3 featured-and-active entries (this redesign,
   Maple Glen, Security Line Card) — only the most recent of those
   surfaces here; the others appear on /projects/. */
const featuredProjects = (await getCollection('work', ({ data }) =>
  data.active !== false && data.featured === true
))
  .sort((a, b) => b.data.completed.valueOf() - a.data.completed.valueOf());
const leadProject = featuredProjects[0];

const allPosts = (await getCollection('writing', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = allPosts.slice(0, 2);

/* Marquee items — the homepage marquee between hero and Recent grid.
   Visual + behavioral spec: portfolio-redesign-agent/decisions/002-
   homepage-marquee-and-nozzle-affordance.md (Candidate C steam-clearing
   reveal, locked 2026-05-14).

   v1 launch (interim): single item — post 010 "Embracing AI" — until
   semantic search ships. Once search ships, push the search demo to the
   front of the array; post 010 stays in rotation (rotation mechanism is
   built; auto-cycles when items.length > 1).

   When chat ships at v1.1, prepend a chat marquee item ahead of search.
   The combined surface UX (chat + search behind one nozzle) is still
   TBD — see decisions/002 §4. */
const post010 = allPosts.find((p) => p.slug === 'obsolescence-was-the-wrong-fear');
const marqueeItems: MarqueeItem[] = [];
if (post010) {
  marqueeItems.push({
    title: post010.data.title,
    framing: post010.data.summary,
    primaryCta: {
      href: `/lessons-learned/${post010.slug}/`,
      label: 'Read the post →',
    },
  });
}

/* TEMP — verification-only second marquee item to observe the rotation
   animation live (steam-thicken → content-swap → steam-thin, ~1.5s
   total, 10s interval). Remove before any commit that ships to
   staging or prod. The real second item lands when the semantic
   search build pipeline ships at v1 — at which point this stub gets
   replaced with the actual search-demo card data. Includes a
   secondaryCta so both render paths are exercised during the swap. */
marqueeItems.push({
  title: 'Semantic site search',
  framing: 'A self-hosted, server-side embedding search of every post and page. Your queries never leave the site — no third-party data flow.',
  primaryCta: {
    href: '#',
    label: 'Try it →',
  },
  secondaryCta: {
    href: '#',
    label: 'Read how I built it →',
  },
});
---
<BaseLayout
  title="Sean Reardon"
  description="Sean Reardon — building front-end since 1998, full-stack since 2014, integrating AI language models as first-class material in the web stack. Based in Buffalo, NY."
  noPageTitleBar={true}
>
  {/* Hero — opening question (h1) + tagline (h2 stone strip).
      The h1 inherits a custom "energy quote box" treatment (see CSS
      below); the h2 inherits a verdigris/dark-stone "step" treatment.
      `text-wrap: balance` lets the question split into multi-line
      shapes that feel deliberate at any width. */}
  <h1 class="hero-question">
    What becomes possible when an AI language model is integrated as first-class material into the stack?
  </h1>
  {/* Hero tagline — refactored 2026-05-20 from inline h2+CSS-block (~225 lines)
      to the StoneTagline component. The previous block in this file was a
      duplicate of the same stone-bar treatment the StoneTagline component
      now encapsulates (extracted in the About Me work to support the AI
      quote). Component identity-mapping: `text` prop = the line that
      previously lived inside the inner span. The component handles the
      cracked-stone bg, dark-glass plaque, four corner standoffs, padding
      tiers, bg-size swap at ≥1080px, white-space nowrap, and the
      .full-bleed opt-out from the wide-measure + h2 drawer global rules. */}
  <StoneTagline text="Building front-end since 1998 and full-stack since 2014 — and lately, that's the question driving my designs." />

  {/* Marquee — single featured AI-features item, full-bleed steam-clearing
      band. v1 launches with post 010 as the interim item; rotation
      mechanism is built so additional items (semantic search demo, chat
      demo) drop in without refactor. See decisions/002 §2. */}
  {marqueeItems.length > 0 && (
    <MarqueeFeature items={marqueeItems} />
  )}

  {/* Marquee ledge — recessed band beneath the marquee. Two textures
      are passed in as CSS variables; CSS picks which one to render
      based on viewport width:
        - --ledge-image (broken-ledge.png) → used at <960px
        - --ledge-image-lg (broken-ledge-lg.png) → used at ≥960px
      Strong inset shadows around the edges preserve the recessed feel.
      Full-bleeds to main's edges (matches the marquee's
      negative-margin pattern). */}
  <div
    class="marquee-ledge"
    style={`--ledge-image: url('${brokenLedge.src}'); --ledge-image-lg: url('${brokenLedgeLg.src}');`}
    aria-hidden="true"
  ></div>

  {/* Recent — laser-border cards via the shared LaserCard component.
      See src/components/astro/LaserCard.astro for the card markup +
      styles + sine-wave hover animation. Grid scales: 1 col at <740,
      2 cols at ≥740, 3 cols at ≥1040. */}
  <section class="recent" aria-labelledby="recent-heading">
    <h2 id="recent-heading" class="full-bleed">Recent</h2>
    <ul class="recent-list">
      {leadProject && (
        <li>
          <LaserCard
            href={`/projects/${leadProject.slug}/`}
            kind="Project"
            title={leadProject.data.title}
            summary={leadProject.data.sh_desc}
            dateISO={leadProject.data.completed.toISOString()}
            dateDisplay={leadProject.data.completed.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
          />
        </li>
      )}
      {posts.map((post) => (
        <li>
          <LaserCard
            href={`/lessons-learned/${post.slug}/`}
            kind="Writing"
            title={post.data.title}
            summary={post.data.summary}
            dateISO={post.data.date.toISOString()}
            dateDisplay={post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* ============================================================================
     Hero — purple energy quote box + stone tagline strip
     ============================================================================
     The home page opts out of the stone full-bleed page-title treatment
     (the global `main > h1:first-of-type` rule excludes .hero-question
     via :not()) — the home page is the only page on the site WITHOUT a
     visible page title bar, since the hero question itself anchors the
     page's voice.

     Treatment: same energy-HUD vocabulary as the mobile nav drawer
     but shifted to near-white CYAN to match the soft cyan halo behind
     the brand-mark logo and gear. */
  .hero-question {
    margin-block: 0 calc(var(--space-md) / 2);
    padding: var(--space-md);
    text-align: center;
    background-color: rgba(0, 0, 0, 0.7);
    background-image: radial-gradient(ellipse at center, rgba(150, 230, 255, 0.42), transparent);
    color: var(--color-fg);
    border: 2px solid rgba(225, 248, 255, 0.95);
    border-radius: var(--radius);
    box-shadow:
      0 0 8px 1px rgba(180, 240, 250, 0.5),
      0 0 20px 3px rgba(102, 232, 255, 0.28),
      inset 0 0 8px 1px rgba(225, 248, 255, 0.4),
      inset 0 0 18px 3px rgba(102, 232, 255, 0.28);
    font-size: 1.75rem;
    line-height: 1.25;
    text-wrap: balance;
  }
  @media (min-width: 740px) {
    .hero-question {
      padding: var(--space-lg) var(--space-md);
      font-size: 2.25rem;
    }
  }
  @media (min-width: 1040px) {
    .hero-question {
      padding: var(--space-lg);
      font-size: 2.75rem;
    }
  }

  /* Hero tagline styling lives in src/components/astro/StoneTagline.astro
     (refactored 2026-05-20 — was ~230 lines of duplicate CSS in this file).
     Markup is now `<StoneTagline text="..." />` above; the component
     handles the cracked-stone bg + dark-glass plaque + 4 corner
     standoffs + padding tiers + bg-size swap at ≥1080px + nowrap, and
     applies the `.full-bleed` opt-out class so the wide-measure + h2
     drawer global rules don't reapply. */

  /* Recent-section heading — standalone copy of the StoneTagline stone-strip
     styling (per 2026-05-15 direction: keep separate so the hero tagline
     and Recent heading can evolve independently). Refactored above to the
     StoneTagline component; this .recent h2 block stays inline because
     it's a deliberately-divergent copy. If the two surfaces should stay
     visually identical going forward, this block could ALSO move into
     the StoneTagline component or a sister component — but Sean's
     original direction was to let them diverge, so this stays. */
  .recent h2 {
    margin-block: 0 var(--space-md);
    margin-inline: calc(-1 * var(--space-md));
    padding: var(--space-xs) var(--space-md);
    text-align: center;

    background:
      radial-gradient(ellipse 90% 130% at center,
        rgba(40, 32, 22, 0.45) 0%,
        rgba(40, 32, 22, 0.2) 40%,
        transparent 75%),
      linear-gradient(170deg,
        #ADA593 0%,
        #877E6E 60%,
        #6F6759 100%);

    color: #ccc;
    text-shadow:
      -1px -1px 3px black,
      1px 1px 3px rgba(255, 255, 255, 0.5);

    box-shadow:
      inset 0 5px 9px rgba(255, 245, 220, 0.65),
      inset 0 -8px 14px rgba(15, 8, 2, 0.85);
    border-bottom: 1px solid rgba(20, 12, 5, 0.8);

    font-family: var(--font-subhead);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.4;
    text-wrap: balance;
  }
  @media (min-width: 740px) {
    .recent h2 {
      font-size: 1.5rem;
    }
  }
  @media (min-width: 1040px) {
    .recent h2 {
      font-size: 1.75rem;
    }
  }

  /* ============================================================================
     Marquee ledge — cool-slate recessed band
     ============================================================================
     Sits immediately below the marquee (touches the marquee's bottom
     edge per its margin-block 0 var(--space-lg) pattern). Full-bleeds
     to main's outer edges via the same negative-inline-margin pattern
     as the hero h2 + marquee.

     Visual goal: a cool-slate stone ledge with visible cracks but
     still all-in-place — like a weathered stone band recessed into
     the surrounding surface. The recessed feel comes from:
       1. Strong inset box-shadow (alpha 0.7 black) on all four edges
       2. Vertical gradient darkening toward the bottom (suggests
          the ledge curves slightly back into the wall)
       3. Hairline near-black borders on top and bottom

     Cracks are thin dark linear gradients at varied angles (~95°,
     ~118°, ~140°) crossing the surface. Each is just a few alpha
     stops wide so they read as fault lines, not openings. The stone
     stays visually intact. */
  .marquee-ledge {
    overflow: hidden;            /* clip the image if it overflows the ledge box */
    margin-inline: calc(-1 * var(--space-md));
    height: 3.5rem;
    /* --ledge-bg-size controls the background-size for the texture
       layer. Below 740px: `auto` (natural pixel size, centered) — the
       image fits comfortably within the smaller viewport. At ≥740px
       (media query below): `100% auto` — the image scales to full
       ledge width with height auto-derived so the aspect ratio is
       preserved (no horizontal distortion); some top/bottom clipping
       is expected and acceptable since the 3.5rem ledge is shorter
       than the scaled image height. */
    --ledge-bg-size: auto;
    /* Two-layer background:
         1. broken-ledge.png texture, centered, sized via --ledge-bg-size.
            --ledge-image is set inline on the element so the
            Astro-hashed asset URL flows in.
         2. Base slate gradient as fallback for any uncovered area. */
    background:
      var(--ledge-image) center / var(--ledge-bg-size) no-repeat,
      linear-gradient(180deg, #555c63 0%, #454a51 100%);
    /* Box-shadow shifted 2026-05-15: previously had 5 dark inset shadows
       on all edges (heavy "recessed" feel). Now reduced to two — a
       subtle copper-orange heat glow at the top (cast from the
       marquee's heat radial above), and the original dark shadow at
       the bottom. Reads as the marquee's heat continuing onto the
       ledge's top edge before fading. */
    box-shadow:
      inset 0 6px 18px rgba(196, 110, 50, 0.32),
      inset 0 -4px 6px rgba(0, 0, 0, 0.6);
    /* border-top removed 2026-05-15 — eliminates the visible black
       seam between the marquee's bottom and the ledge's top. The heat
       glow (inset top shadow) now flows continuously from the marquee's
       bottom edge onto the ledge's top edge.
       border-bottom kept — defines the ledge's lower edge against
       whatever follows (currently the Recent grid). */
    border-bottom: 1px solid rgba(0, 0, 0, 0.55);
  }
  @media (min-width: 740px) {
    .marquee-ledge {
      --ledge-bg-size: 100% auto;
    }
  }
  @media (min-width: 960px) {
    /* At wide screens, swap to the wider texture variant
       (broken-ledge-lg.png) and scale it to fill the ledge's width
       at 100% with height auto-derived. The lg image is sized so
       its natural pattern reads well across wider viewports without
       needing to mirror/tile the smaller broken-ledge.png. */
    .marquee-ledge {
      --ledge-bg-size: 100% auto;
      background:
        var(--ledge-image-lg) center / var(--ledge-bg-size) no-repeat,
        linear-gradient(180deg, #555c63 0%, #454a51 100%);
    }
  }

  /* ============================================================================
     Recent section
     ============================================================================
     Section sits well below the hero. Heading uses default h2 styling
     (Cardo) from global.css. Card layout: 1 col / 2 col / 3 col at
     <740 / ≥740 / ≥1040. */
  .recent {
    margin-block-start: var(--space-sm);
  }

  .recent-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }
  @media (min-width: 740px) {
    .recent-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .recent-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* 2-col tier orphan-centering: when the total card count is odd
     (currently 3 — 1 project + 2 posts), the last card lands alone
     in its row at this 2-col viewport. Span it across both columns +
     constrain width to single-column-width + justify-self: center so
     it sits horizontally centered instead of left-stranded.
     Scoped to 740-1039 only — the 1-col tier has no orphan problem
     (everything stacks single-file), and the 3-col tier handles its
     own orphan layouts (and currently has none with 3 cards). The
     :last-child:nth-child(odd) compound selector generalizes the rule
     to any future odd card count (5, 7, …), not just exactly-three. */
  @media (min-width: 740px) and (max-width: 1039.98px) {
    .recent-list li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      width: calc(50% - var(--space-md) / 2);
      justify-self: center;
    }
  }
</style>
