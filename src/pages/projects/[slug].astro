---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('work', ({ data }) => data.active !== false);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
---
<BaseLayout title={project.data.title} description={project.data.sh_desc}>
  {/* No `data-pagefind-body` here — work entries are deliberately OUT of the
      v1 search corpus per `decisions/ai-features-v1.md` decision 9 ("short
      metadata-heavy stubs"; not the visitor-search target). BaseLayout's
      default `searchable={false}` puts `data-pagefind-ignore` on <main>, and
      without an inner `data-pagefind-body` to override that, Pagefind skips
      these pages entirely. If a future scope change adds work entries to
      the corpus, set `searchable={true}` on the BaseLayout call AND add
      `data-pagefind-body` to this article (mirroring the lessons-learned
      route). Update `src/lib/search/chunker.ts` in lockstep so the MiniLM
      and Pagefind corpora stay aligned. */}
  <article>
    <p class="meta">
      Completed {project.data.completed.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
      {project.data.projLink && (
        <> · <a href={project.data.projLink} rel="external nofollow noopener">Live project ↗</a></>
      )}
    </p>
    <p class="lead">{project.data.sh_desc}</p>

    {/* Hero image — renders only when mainImg has a Cloudflare Images URL
        populated. The legacy-project migration pipeline (see
        scripts/MIGRATION-README.md) is what populates this field; before
        that runs, mainImg is undefined and this block is skipped. The
        legacyMainImg field stays in frontmatter regardless as a paper
        trail. */}
    {project.data.mainImg && (
      <img
        src={project.data.mainImg}
        alt={`${project.data.title} — main image`}
        class="project-hero-img"
        loading="lazy"
      />
    )}

    <Content />

    {/* Secondary images — comma-separated CF Images URLs. Same population
        story as mainImg; renders nothing until the migration runs. */}
    {project.data.otherImg && (
      <div class="project-other-imgs">
        {project.data.otherImg.split(',').map((url) => url.trim()).filter(Boolean).map((url, i) => (
          <img
            src={url}
            alt={`${project.data.title} — image ${i + 2}`}
            class="project-other-img"
            loading="lazy"
          />
        ))}
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .meta {
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .lead { font-size: 1.125rem; }
  .project-hero-img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin-block: var(--space-md);
    border-radius: 0.25rem;
  }
  .project-other-imgs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }
  .project-other-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.25rem;
  }
</style>
