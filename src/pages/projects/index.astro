---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LaserCard from '~/components/astro/LaserCard.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work', ({ data }) => data.active !== false))
  .sort((a, b) => b.data.completed.valueOf() - a.data.completed.valueOf());
---
<BaseLayout
  title="Projects"
  description="Shipped projects by Sean Reardon — a track record of production web work, with brief retrospective writeups focused on technical decisions and outcomes."
>
  <p>
    A track record of shipped web projects, with brief retrospective writeups
    focused on technical decisions and outcomes.
  </p>

  {work.length === 0 ? (
    <p>
      <em>(Project entries will be migrated from the legacy MariaDB
      <code>projects</code> table — 10 rows, oldest 2015, newest 2020. See
      <code>inventory/seanreardon-com-2026-05-02.md</code> in the planning
      project for the migration plan.)</em>
    </p>
  ) : (
    <ul class="laser-card-list">
      {work.map((project) => (
        <li>
          <LaserCard
            href={`/projects/${project.slug}/`}
            kind="Project"
            title={project.data.title}
            summary={project.data.sh_desc}
            dateISO={project.data.completed.toISOString()}
            dateDisplay={project.data.completed.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
          />
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  /* Single-column list of LaserCards. Cards self-contain their visual
     treatment (see LaserCard.astro); this list just controls layout
     and spacing. At wider tiers the cards naturally widen with main's
     max-width — no responsive column changes needed for the projects
     view since each entry warrants the full reading width. */
  .laser-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }
</style>
