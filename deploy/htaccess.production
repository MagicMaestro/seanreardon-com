# .htaccess for seanreardon.com (production) — gets copied to dist/.htaccess by the eventual deploy-production workflow.
#
# Purpose: serve the Astro static export at the production domain with
# proper caching, AI-bot blocking, and 301 redirects from legacy PHP URLs.

# Allow indexing by regular search engines
<IfModule mod_headers.c>
    # No X-Robots-Tag noindex header here (vs staging, which blocks all)
</IfModule>

# Astro static export with trailing-slash routes
Options -MultiViews
DirectoryIndex index.html

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 301 redirects from legacy PHP URLs (added during cutover)
# Format: RewriteRule ^old-path$ /new-path/ [R=301,L]

# Legacy site routes from the inventory:
RewriteRule ^home\.php$ / [R=301,L]
RewriteRule ^about\.php$ /about/ [R=301,L]
RewriteRule ^projects\.php$ /work/ [R=301,L]
RewriteRule ^services\.php$ /about/ [R=301,L]
RewriteRule ^contact\.php$ /contact/ [R=301,L]

# Single-project query-param redirects from the legacy /project.php?projID=N URLs.
# Each rule pairs RewriteCond on %{QUERY_STRING} with a RewriteRule on the path.
# Trailing `?` on the target strips the original query string so the redirect lands
# cleanly at /work/<slug>/ without ?projID=... appended.
# Generated from each MDX entry's legacyProjID frontmatter.
RewriteCond %{QUERY_STRING} ^projID=2839760$
RewriteRule ^project\.php$ /work/avox-supplier-portal/? [R=301,L]
RewriteCond %{QUERY_STRING} ^projID=1320212$
RewriteRule ^project\.php$ /work/azalias-juicery/? [R=301,L]
RewriteCond %{QUERY_STRING} ^projID=10946275$
RewriteRule ^project\.php$ /work/invisible-creation-photography/? [R=301,L]
RewriteCond %{QUERY_STRING} ^projID=2132958$
RewriteRule ^project\.php$ /work/maple-glen-sugarhouse/? [R=301,L]
RewriteCond %{QUERY_STRING} ^projID=14375097$
RewriteRule ^project\.php$ /work/peaceful-soul-farmers-market/? [R=301,L]
RewriteCond %{QUERY_STRING} ^projID=3473721$
RewriteRule ^project\.php$ /work/security-line-card/? [R=301,L]
RewriteCond %{QUERY_STRING} ^projID=1574811$
RewriteRule ^project\.php$ /work/sr-web-portfolio/? [R=301,L]
RewriteCond %{QUERY_STRING} ^projID=15955631$
RewriteRule ^project\.php$ /work/triple-cities-insurance-site/? [R=301,L]
# Bare /project.php (no projID) → /work/ index
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^project\.php$ /work/ [R=301,L]

# Invisible Light Photography URLs (retired 2026-05-02; will 301 to the
# Angular site's domain once that's known):
# RewriteRule ^invisiblelight/?(.*)$ https://<future-photography-domain>/$1 [R=301,L]

# Cache headers — same as staging
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml application/json text/plain
</IfModule>

ErrorDocument 404 /404.html
