# .htaccess for staging.seanreardon.com — gets copied to dist/.htaccess by the GitHub Actions deploy workflow.
#
# Purpose: serve the Astro static export at the staging subdomain WITHOUT
# being publicly accessible. Two-layer protection, primary + defense-in-depth:
#
#   1. HTTP Basic Auth (block immediately below) — PRIMARY access gate.
#      Visitors must authenticate before reaching any content. The .htpasswd
#      file lives OUTSIDE the document root at
#      /home/sreardon/.htpasswds/staging.htpasswd so the deploy workflow's
#      `rsync --delete` doesn't wipe it. Optimizer brief 013 (2026-05-26
#      hand-back) generated the file with bcrypt-hashed credentials; Apache
#      reads it via group ownership (file is 0640 sreardon:nobody; Apache
#      runs as `nobody` per the cPanel prefork config). AuthName realm
#      string must match the optimizer's verified value verbatim — changing
#      it invalidates browsers' stored credentials and forces re-auth.
#
#   2. X-Robots-Tag header + staging-specific robots.txt — DEFENSE-IN-DEPTH
#      for SEO. Even if auth ever fails open (rollback, misconfiguration,
#      future bypass), search engines still see noindex/nofollow/noarchive/
#      nosnippet on every response, AND the staging robots.txt (swapped in
#      by deploy-staging.yml) Disallows all crawlers from /. Both signals
#      survive any single failure of the other.

# Primary access gate — HTTP Basic Auth.
# .htpasswd lives outside the doc root (per optimizer brief 013 hand-back —
# survives every `rsync --delete` deploy). Bcrypt-hashed credentials only;
# no plaintext stored server-side. Apache reads via the file's 0640
# sreardon:nobody ownership.
AuthType Basic
AuthName "Staging Preview — Sean Reardon"
AuthUserFile /home/sreardon/.htpasswds/staging.htpasswd
Require valid-user

# Defense-in-depth: block ALL crawlers from indexing.
# Only meaningful if Basic Auth above ever fails open — under normal
# operation, unauthenticated requests get 401 before this header is sent.
# Kept as a belt-and-braces layer that survives auth misconfiguration.
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# Astro static export with trailing-slash routes — Apache MultiViews can interfere
Options -MultiViews

# Default index file
DirectoryIndex index.html

# Force HTTPS (cPanel/AutoSSL handles the cert; staging shouldn't be HTTP)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pagefind WebAssembly files (Sean discovered 2026-05-22 iter 9 — see
# htaccess.production for the full diagnostic). Pagefind names its wasm
# files with the `.pagefind` extension, which Apache doesn't auto-detect
# as application/wasm. Without the correct Content-Type, browsers refuse
# to compile the WebAssembly module (nosniff is enforced), Pagefind's
# search engine fails to initialize, and search returns no results.
# Mirroring this on staging so the search dropdown + /search page work
# identically across both environments.
<IfModule mod_mime.c>
    <FilesMatch "^wasm\..+\.pagefind$">
        ForceType application/wasm
    </FilesMatch>
</IfModule>

# Cache static assets for 1 year (immutable hashed filenames from Astro/Vite)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 5 minutes"
</IfModule>

# Custom 404 — Astro's static export creates dist/404.html
ErrorDocument 404 /404.html

# Compress text responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml application/json text/plain
</IfModule>
